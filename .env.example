# Copy this file to `.env` (already git-ignored — see .gitignore) and fill in real
# values. Nothing in THIS file is a real secret; every value below is a placeholder
# (TECH_SPEC §8, ACTION_PLAN E2-09).

# --- Database (bundled container) --------------------------------------------
# Password for the "app" Postgres role in the bundled `db` service. Generate a strong
# random value for real environments — never reuse this placeholder.
# Only used when the stack runs its OWN Postgres (the default). Ignored entirely when
# you deploy against an external database — see the next section.
DB_PASSWORD=change-me-to-a-strong-random-password

# --- Database (EXTERNAL / Neon) — optional, E2-11 ------------------------------
# Set this ONLY when pointing the api at a managed Postgres instead of the bundled
# `db` container, and start the stack with the external-db override file:
#
#   docker compose -f docker-compose.yml -f docker-compose.external-db.yml \
#                  --profile prod up -d
#
# That override drops the `db` service and its healthcheck dependency entirely, so
# the value below is the ONLY thing telling the API where its database lives. It is
# required (not defaulted) under that override — compose fails fast if it is unset,
# which is deliberate: a silently-empty connection string would otherwise surface as
# an obscure startup error.
#
# FORMAT — this is the part that bites. Neon's dashboard hands you a URI:
#
#   postgresql://neondb_owner:npg_ExAmPlE1234@ep-cool-darkness-a1b2c3d4-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# **Npgsql does not accept that URI form.** It parses only ADO.NET keyword=value
# pairs, so pasting the dashboard string straight in fails at startup. Translate it
# by hand — the equivalent of the URI above is:
#
#   Host=ep-cool-darkness-a1b2c3d4-pooler.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=npg_ExAmPlE1234;SSL Mode=Require;Channel Binding=Require;No Reset On Close=true
#
# Mapping, field by field:
#   user:password@   -> Username=... ;Password=...
#   host             -> Host=...   (port is implicit 5432 in the URI; state it explicitly)
#   /dbname          -> Database=...
#   ?sslmode=require -> SSL Mode=Require
#   &channel_binding=require -> Channel Binding=Require
#
# Notes on the three settings that are NOT a mechanical translation:
#   * SSL Mode=Require is mandatory — Neon refuses plaintext connections. Do NOT add
#     `Trust Server Certificate=true`: Npgsql 8+ validates the certificate under
#     `Require`, Neon's cert chains to a public CA, and validation passes on its own.
#     Adding the trust flag would silently disable that check for no benefit.
#   * Prefer the `-pooler` hostname (as above). Neon fronts it with PgBouncer in
#     transaction mode, which suits this app's short-request connection pattern and
#     survives Neon's scale-to-zero far better than the direct endpoint.
#   * `No Reset On Close=true` goes WITH the `-pooler` host: Npgsql otherwise issues
#     `DISCARD ALL` when returning a connection to its pool, which PgBouncer's
#     transaction mode rejects. Drop this setting if you use the direct (non-pooler)
#     endpoint.
#
# EVERY VALUE ABOVE IS A PLACEHOLDER. Never commit a real Neon password — this file
# is the example; the real value belongs in the git-ignored `.env` (E2-09).
#DATABASE_CONNECTION_STRING=Host=ep-cool-darkness-a1b2c3d4-pooler.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=npg_ExAmPlE1234;SSL Mode=Require;Channel Binding=Require;No Reset On Close=true

# --- JWT ----------------------------------------------------------------------
# Signing key for access tokens (TECH_SPEC §4.2). MUST be at least 256 bits (32+
# characters) of high-entropy random data in Production — the API fails fast at
# startup if it is missing or too short in that environment. Generate with e.g.
# `openssl rand -base64 48`.
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-chars

# --- Caching (TECH_SPEC §4.5, C2) ---------------------------------------------
# "InMemory" (default) or "Redis". Only meaningful together with `docker compose
# --profile redis up`, which is the only way the redis container starts.
CACHING_PROVIDER=InMemory
REDIS_CONNECTION_STRING=redis:6379

# --- File storage --------------------------------------------------------------
# "LocalDisk" (default) or "S3". Under LocalDisk the root path is set inside the
# container by the compose file (Storage__RootPath=/data/uploads) and there is nothing
# to override here.
#
# "S3" (H-19) routes every document — including the PDFs behind the temporary WhatsApp
# share links — to S3-compatible object storage. For the bundled MinIO container:
#
#     STORAGE_PROVIDER=S3
#     docker compose --profile minio up -d
#
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below are used TWICE: MinIO creates that
# account on first boot, and the api container signs its S3 requests with it. There
# are no shipped defaults on purpose — an object store holding every invoice and
# catalogue is not somewhere to leave a committed credential (E2-09). Required only
# when STORAGE_PROVIDER=S3; ignored otherwise.
#
# Pointing at managed S3 instead: leave STORAGE_S3_SERVICE_URL empty, set
# Storage__S3__Region, and leave the keys blank to use the SDK's ambient credential
# chain (instance profile / environment).
STORAGE_PROVIDER=LocalDisk
STORAGE_S3_SERVICE_URL=http://minio:9000
STORAGE_S3_BUCKET=sourcingops
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Bootstrap Super Admin (E1-03 addition — see build report) -----------------
# The values below are the SHIPPED DEFAULTS — a fresh database seeds exactly this
# owner account, ready to sign in with, no forced password change. Change them here
# before first boot for any deployment that is not a local/demo one: this file is
# committed, so the password below is public knowledge.
#
# If AdminPassword is left BLANK, the behaviour is different: a random temp password
# is generated, printed to the API's stdout logs ONCE on first startup (the run that
# actually creates the account), and the account is flagged MustChangePassword=true —
# capture it from `docker compose logs api` immediately after first boot and change it
# at the forced-change screen. A secret that reached a log has to be rotated, which is
# why only that case forces a change.
#
# Either way this only applies to the run that CREATES the account. The seeder never
# resets an existing user's password (E1-03 idempotency) — editing these afterwards
# does nothing; use the in-app "Change password" screen instead (E11-06).
BOOTSTRAP_ADMIN_EMAIL=owner@sourcingops.local
BOOTSTRAP_ADMIN_PASSWORD=Welcome@123

# --- CORS / frontend origin ------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:4200

# --- Caddy (production only — E2-04) ---------------------------------------------
# Real deploy: your domain, e.g. sourcingops.example.com — Caddy provisions a TLS
# cert automatically via Let's Encrypt.
# Local verification (no public DNS): use ":80" so Caddy serves plain HTTP instead of
# attempting ACME issuance.
CADDY_DOMAIN=:80
