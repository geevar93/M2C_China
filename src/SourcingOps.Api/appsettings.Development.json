{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // ACTION_PLAN N-23. `appsettings.json` ships `Jwt:SigningKey` as "" because in every
  // deployed environment it arrives from the environment (docker-compose passes
  // `Jwt__SigningKey=${JWT_SIGNING_KEY}`). Running the API straight from source picks up
  // neither, so it would start, connect to the database, and then throw
  // `IDX10703: key length is zero` on the first login — a 500 that reads like a credentials
  // problem and is not.
  //
  // This value is for LOCAL DEVELOPMENT ONLY and is deliberately committed: it is not a
  // secret, it guards nothing, and every developer's machine wanting a different one is pure
  // friction. It is safe precisely because it can never reach a deployed environment —
  // ASP.NET Core only loads this file when ASPNETCORE_ENVIRONMENT=Development, and both the
  // container and the deploy pipeline set the real key from `JWT_SIGNING_KEY`, which
  // overrides anything here.
  //
  // Length matters: HS256 needs >= 256 bits of key material, which is why this string is
  // long rather than a token like "dev".
  "Jwt": {
    "SigningKey": "local-dev-only-signing-key-not-a-secret-min-32-bytes"
  }
}
