  "Storage": {
    "RootPath": "/data/uploads",
    "MaxUploadSizeBytes": 20971520
  },
  "Bootstrap": {
    "AdminEmail": "owner@sourcingops.local",
    "AdminPassword": "Welcome@123"
  },
  "Cors": {
    "FrontendOrigin": "http://localhost:4200"
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60
  },
  "Customers": {
    "DefaultCountryPhoneCode": "+91"
  }
