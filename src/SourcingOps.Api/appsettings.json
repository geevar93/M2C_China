{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // The value below is a LOCAL FALLBACK ONLY and is never the one a deployed
  // environment uses — docker-compose passes `ConnectionStrings__Default` from the
  // environment, which always wins over this file. (Comments are legal here: ASP.NET
  // Core's JSON configuration provider skips them; appsettings.Development.json has
  // relied on that since N-23.)
  //
  // EXTERNAL / MANAGED POSTGRES (Neon) — ACTION_PLAN E2-11. Nothing in the code needs
  // to change to point at one: this string is the sole input to `UseNpgsql(...)` in
  // Infrastructure/DependencyInjection.cs and to AppDbContextFactory (the design-time
  // factory the migration step uses), and EF Core + Npgsql speak to any
  // Postgres-compatible endpoint. It is a connection-string swap, not a provider swap.
  //
  // The one trap: **Npgsql does not accept the `postgresql://user:pass@host/db` URI
  // that Neon's dashboard shows you.** It parses ADO.NET keyword=value pairs only, so
  // the dashboard string must be translated. Neon's equivalent looks like:
  //
  //   Host=ep-cool-darkness-a1b2c3d4-pooler.us-east-2.aws.neon.tech;Port=5432;
  //   Database=neondb;Username=neondb_owner;Password=<placeholder>;
  //   SSL Mode=Require;Channel Binding=Require;No Reset On Close=true
  //
  // `SSL Mode=Require` is mandatory (Neon refuses plaintext) and needs no
  // `Trust Server Certificate` — Npgsql 8+ validates under Require and Neon's
  // certificate chains to a public CA. `No Reset On Close=true` pairs with the
  // `-pooler` hostname, whose PgBouncer transaction mode rejects Npgsql's default
  // `DISCARD ALL` on connection return.
  //
  // Placeholder credentials only, here and everywhere in the repo. The real value
  // belongs in the git-ignored `.env` (E2-09) — see `.env.example`'s
  // DATABASE_CONNECTION_STRING block for the full field-by-field mapping, and
  // `docker-compose.external-db.yml` for the compose wiring that drops the bundled
  // `db` container.
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sourcingops;Username=app;Password=changeme"
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "SourcingOps",
    "Audience": "SourcingOps.Client"
  },
  "Auth": {
    "AccessTokenLifetimeMinutes": 480,
    "RefreshTokenLifetimeDays": 30
  },
  "Caching": {
    "Provider": "InMemory",
    "InMemory": { "SizeLimitMb": 64 },
    "Redis": { "ConnectionString": "", "InstanceName": "sourcingops:" }
  },
  "Storage": {
    "Provider": "LocalDisk",
    "RootPath": "/data/uploads",
    "MaxUploadSizeBytes": 20971520,
    "S3": {
      "ServiceUrl": "http://minio:9000",
      "BucketName": "sourcingops",
      "ForcePathStyle": true,
      "Region": "us-east-1",
      "CreateBucketIfMissing": true
    }
  },
  "Bootstrap": {
    "AdminEmail": "owner@sourcingops.local",
    "AdminPassword": "Welcome@123"
  },
  "Cors": {
    "FrontendOrigin": "http://localhost:4200"
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "SharedDocumentPermitLimit": 60,
    "SharedDocumentWindowSeconds": 60
  },
  "Dispatch": {
    "ShareLinkLifetimeHours": 48,
    "PublicBaseUrl": ""
  },
  "Customers": {
    "DefaultCountryPhoneCode": "+91"
  }
}
